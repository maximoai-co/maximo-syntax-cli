#!/usr/bin/env node

/**
 * Maximo Syntax CLI — Maximo Syntax with any LLM, powered by Maximo AI
 *
 * If dist/cli.mjs exists (built), run that.
 * Otherwise, tell the user to build first or use `bun run dev`.
 */

import { existsSync } from "fs";
import { join, dirname } from "path";
import { fileURLToPath, pathToFileURL } from "url";

// Raise the V8 old-space ceiling for child processes (sub-agents, etc.) so
// long sessions don't hit the default ~2GB heap. Setting NODE_OPTIONS here
// affects processes the CLI spawns; the main process heap is governed by the
// shebang's node invocation, which we can't change at runtime. Never override
// an explicit user-set value.
if (!/\b--max-old-space-size=\d+\b/.test(process.env.NODE_OPTIONS || "")) {
  const existing = process.env.NODE_OPTIONS || "";
  process.env.NODE_OPTIONS = existing
    ? `${existing} --max-old-space-size=6144`
    : "--max-old-space-size=6144";
}

const __dirname = dirname(fileURLToPath(import.meta.url));
const distPath = join(__dirname, "..", "dist", "cli.mjs");

if (existsSync(distPath)) {
  await import(pathToFileURL(distPath).href);
} else {
  console.error(`
  maximo-syntax-cli: dist/cli.mjs not found.

  Build first:
    bun run build

  Or run directly with Bun:
    bun run dev

  See README.md for setup instructions.
`);
  process.exit(1);
}
